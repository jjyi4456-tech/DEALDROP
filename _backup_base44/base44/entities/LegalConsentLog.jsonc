{
  "name": "LegalConsentLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string"
    },
    "merchant_name": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "merchant_agreement",
        "privacy_policy",
        "receipt_processing",
        "cookie_consent"
      ]
    },
    "version": {
      "type": "string",
      "default": "v1.0"
    },
    "accepted_at": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "version"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
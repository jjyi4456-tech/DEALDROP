{
  "name": "UserInventory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "item_key": {
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "emoji": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "item_key",
    "item_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
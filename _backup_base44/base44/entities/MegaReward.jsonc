{
  "name": "MegaReward",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "goal_title": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "percent",
        "cash",
        "menu"
      ]
    },
    "reward_value": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "claimed"
      ],
      "default": "available"
    },
    "awarded_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_id",
    "goal_id",
    "title",
    "reward_type",
    "reward_value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "VoucherOrder",
  "type": "object",
  "properties": {
    "voucher_id": {
      "type": "string"
    },
    "voucher_title": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string"
    },
    "merchant_name": {
      "type": "string"
    },
    "merchant_owner_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "take_rate": {
      "type": "number",
      "default": 10
    },
    "platform_fee": {
      "type": "number",
      "default": 0
    },
    "net_merchant_amount": {
      "type": "number",
      "default": 0
    },
    "payment_method": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded"
      ],
      "default": "pending"
    },
    "order_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "voucher_id",
    "user_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.merchant_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
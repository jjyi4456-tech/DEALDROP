{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string"
    },
    "merchant_name": {
      "type": "string"
    },
    "quest_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "percent",
        "cash",
        "menu"
      ]
    },
    "reward_value": {
      "type": "string"
    },
    "coupon_type": {
      "type": "string",
      "default": "standard"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "used",
        "expired"
      ],
      "default": "available"
    },
    "qr_code": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "type": "string"
    },
    "box_opened": {
      "type": "boolean",
      "default": false
    },
    "redeemed_date": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "merchant"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "merchant"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
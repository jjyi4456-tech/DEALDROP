{
  "name": "Merchant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "cafe",
        "restaurant",
        "beverage",
        "dessert",
        "bakery"
      ]
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "suspended"
      ],
      "default": "pending"
    },
    "reject_reason": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "starter",
        "growth",
        "premium"
      ],
      "default": "starter"
    },
    "address": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "geofence_radius": {
      "type": "number",
      "default": 50
    },
    "quest_quota": {
      "type": "number",
      "default": 30
    },
    "quest_used": {
      "type": "number",
      "default": 0
    },
    "push_quota": {
      "type": "number",
      "default": 0
    },
    "push_used": {
      "type": "number",
      "default": 0
    },
    "logo_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "open_time": {
      "type": "string"
    },
    "close_time": {
      "type": "string"
    },
    "slack_webhook_url": {
      "type": "string"
    },
    "subscription_expires_at": {
      "type": "string"
    },
    "mystery_boost": {
      "type": "number",
      "default": 0
    },
    "current_mayor_user_id": {
      "type": "string"
    },
    "current_mayor_count": {
      "type": "number",
      "default": 0
    },
    "mayor_updated_date": {
      "type": "string"
    },
    "wallet_balance": {
      "type": "number",
      "default": 100
    },
    "commission_rate": {
      "type": "number",
      "default": 0.06
    },
    "is_pro": {
      "type": "boolean",
      "default": false
    },
    "active_plan_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "tiktok": {
      "type": "string"
    },
    "story_boost_enabled": {
      "type": "boolean",
      "default": false
    },
    "story_boost_percent": {
      "type": "number",
      "default": 5
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
          "then": "end",
          "x-base44": {
            "title": "\u0e15\u0e31\u0e14\u0e23\u0e2d\u0e1a\u0e1a\u0e34\u0e25\u0e1b\u0e23\u0e30\u0e08\u0e33\u0e40\u0e14\u0e37\u0e2d\u0e19",
            "description": "\u0e2a\u0e23\u0e38\u0e1b GMV \u0e41\u0e25\u0e30\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e23\u0e2d\u0e1a\u0e08\u0e48\u0e32\u0e22\u0e40\u0e07\u0e34\u0e19"
          }
        }
      }
    ]
  },
  "name": "Monthly Settlement Report",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 1 * *",
      "one_time_date": null,

{
  "name": "\u0e41\u0e08\u0e49\u0e07\u0e40\u0e15\u0e37\u0e2d\u0e19\u0e23\u0e49\u0e32\u0e19\u0e04\u0e49\u0e32\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e20\u0e32\u0e23\u0e01\u0e34\u0e08\u0e04\u0e23\u0e1a\u0e42\u0e04\u0e27\u0e15\u0e32",
  "description": "\u0e2a\u0e48\u0e07\u0e2d\u0e35\u0e40\u0e21\u0e25 Gmail \u0e41\u0e08\u0e49\u0e07\u0e23\u0e49\u0e32\u0e19\u0e04\u0e49\u0e32\u0e17\u0e31\u0e19\u0e17\u0e35\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e1c\u0e39\u0e49\u0e40\u0e02\u0e49\u0e32\u0e23\u0e48\u0e27\u0e21\u0e20\u0e32\u0e23\u0e01\u0e34\u0e08\u0e04\u0e23\u0e1a\u0e15\u0e32\u0e21\u0e08\u0e33\u0e19\u0e27\u0e19\u0e17\u0e35\u0e48\u0e23\u0e2d\u0e07\u0e23\u0e31\u0e1a",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Quest",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"active\" and .trigger.data.capacity > 0 and .trigger.data.participants >= .trigger.data.capacity and ((.trigger.old_data.participants // 0) < .trigger.data.capacity) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "quest_quota_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyMerchantQuest",
            "args": {
              "quest_id": "${ .trigger.entity_id }",
              "reason": "quota_full"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0e2a\u0e48\u0e07\u0e2d\u0e35\u0e40\u0e21\u0e25\u0e41\u0e08\u0e49\u0e07\u0e04\u0e23\u0e1a\u0e42\u0e04\u0e27\u0e15\u0e32",
            "description": "\u0e40\u0e23\u0e35\u0e22\u0e01 notifyMerchantQuest"
          }
        }
      }
    ]
  }
}
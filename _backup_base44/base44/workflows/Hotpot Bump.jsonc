{
  "name": "\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e2d\u0e38\u0e13\u0e2b\u0e20\u0e39\u0e21\u0e34\u0e2b\u0e21\u0e49\u0e2d\u0e44\u0e1f\u0e23\u0e27\u0e21\u0e1e\u0e25\u0e31\u0e07",
  "description": "\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e21\u0e35\u0e01\u0e32\u0e23\u0e40\u0e0a\u0e47\u0e04\u0e2d\u0e34\u0e19\u0e2a\u0e33\u0e40\u0e23\u0e47\u0e08 \u0e40\u0e1e\u0e34\u0e48\u0e21\u0e2d\u0e38\u0e13\u0e2b\u0e20\u0e39\u0e21\u0e34\u0e2b\u0e21\u0e49\u0e2d\u0e44\u0e1f\u0e23\u0e27\u0e21\u0e1e\u0e25\u0e31\u0e07 +1 \u0e2d\u0e07\u0e28\u0e32 \u0e41\u0e25\u0e30\u0e41\u0e08\u0e01 Mega Reward \u0e40\u0e21\u0e37\u0e48\u0e2d\u0e16\u0e36\u0e07\u0e40\u0e1b\u0e49\u0e32\u0e2b\u0e21\u0e32\u0e22",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "CheckIn"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hotpot_bump",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "bump": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "bumpHotpot",
            "args": {
              "checkin_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e2d\u0e38\u0e13\u0e2b\u0e20\u0e39\u0e21\u0e34\u0e2b\u0e21\u0e49\u0e2d\u0e44\u0e1f",
            "description": "\u0e1a\u0e27\u0e01 +1 \u0e2d\u0e07\u0e28\u0e32 \u0e41\u0e25\u0e30\u0e41\u0e08\u0e01\u0e23\u0e32\u0e07\u0e27\u0e31\u0e25\u0e40\u0e21\u0e37\u0e48\u0e2d\u0e04\u0e23\u0e1a\u0e40\u0e1b\u0e49\u0e32"
          }
        }
      }
    ]
  }
}